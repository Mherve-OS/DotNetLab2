<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:LAB2.ViewModels"
             x:Class="LAB2.Views.BicycleView"
             x:DataType="vm:BicycleViewModel">

    <ScrollViewer VerticalScrollBarVisibility="Auto" Background="White">
        <Grid VerticalAlignment="Center" HorizontalAlignment="Center" Margin="24">
            <Border Width="420"
                    Padding="28"
                    Background="White"
                    BorderBrush="#D0D7DE"
                    BorderThickness="1"
                    CornerRadius="6">
                <StackPanel Spacing="16">
                    <!-- Title & Instructions -->
                    <StackPanel Spacing="4" HorizontalAlignment="Center">
                        <TextBlock Text="Bicycle Renting"
                                   FontSize="22"
                                   FontWeight="Bold"
                                   Foreground="#1F2328"
                                   HorizontalAlignment="Center" />
                        <TextBlock Text="Enter starting and ending hours, then click Total."
                                   FontSize="13"
                                   Foreground="#656D76"
                                   HorizontalAlignment="Center" />
                    </StackPanel>

                    <!-- Input 1: Starting Time -->
                    <StackPanel Spacing="6">
                        <TextBlock Text="Starting Time (0 - 23):"
                                   FontSize="14"
                                   FontWeight="SemiBold"
                                   Foreground="#1F2328" />
                        <TextBox Text="{Binding StartTimeText}"
                                 PlaceholderText="e.g. 8"
                                 Height="36" />
                    </StackPanel>

                    <!-- Input 2: Ending Time -->
                    <StackPanel Spacing="6">
                        <TextBlock Text="Ending Time (0 - 24):"
                                   FontSize="14"
                                   FontWeight="SemiBold"
                                   Foreground="#1F2328" />
                        <TextBox Text="{Binding EndTimeText}"
                                 PlaceholderText="e.g. 17"
                                 Height="36" />
                    </StackPanel>

                    <!-- Total Button -->
                    <Button Content="Total"
                            Classes="blue"
                            Command="{Binding CalculateCommand}"
                            HorizontalAlignment="Stretch"
                            Height="38"
                            FontSize="15"
                            Margin="0,4,0,0" />

                    <!-- Output: Total Box -->
                    <StackPanel Spacing="6">
                        <TextBlock Text="Total:"
                                   FontSize="14"
                                   FontWeight="SemiBold"
                                   Foreground="#1F2328" />
                        <TextBox Text="{Binding TotalCostText}"
                                 IsReadOnly="True"
                                 PlaceholderText="Total will appear here"
                                 Height="36" />
                    </StackPanel>

                    <!-- Navigation Footer: Only Two Buttons (Back & Logout) -->
                    <Grid ColumnDefinitions="*,*" Margin="0,10,0,0">
                        <Button Grid.Column="0"
                                Content="Back"
                                Classes="gray"
                                Command="{Binding BackCommand}"
                                Width="110"
                                Height="36"
                                FontSize="14"
                                HorizontalAlignment="Left" />

                        <Button Grid.Column="1"
                                Content="Logout"
                                Classes="red"
                                Command="{Binding LogoutCommand}"
                                Width="110"
                                Height="36"
                                FontSize="14"
                                HorizontalAlignment="Right" />
                    </Grid>
                </StackPanel>
            </Border>
        </Grid>
    </ScrollViewer>

</UserControl>
